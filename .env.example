# PulseForge AI Environment Configuration
PULSEFORGE_ENV=development
PULSEFORGE_MODEL_DIR=./model_artifacts
PULSEFORGE_DEMO_AUDIO_DIR=./demo_audio
PULSEFORGE_MAX_UPLOAD_MB=25
PULSEFORGE_LOG_LEVEL=INFO
PULSEFORGE_ENABLE_HISTORY=true

# Factory Brain AI Copilot (Groq API Key - Free from https://console.groq.com)
# When set, enables live Llama-3.3-70b maintenance reasoning & work order generation.
# If omitted, PulseForge runs in deterministic offline SOP rule-based mode.
GROQ_API_KEY=gsk_your_groq_api_key_here
